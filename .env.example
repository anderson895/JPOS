# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_API_URL=

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Server only: Vercel → Settings → Environment Variables (and .env on
# this computer). Never put VITE_ in front of these: they must not reach the browser.
# The Gmail account JPOS sends email from, and its 16-letter app password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who gets "new payment" emails (comma-separated). Empty = GMAIL_USER
NOTIFY_EMAIL=
# The app's address for links in emails, e.g. https://jpos.example.com
APP_URL=
# Firebase service account key (the whole JSON, or base64 of it)
FIREBASE_SERVICE_ACCOUNT=
# Local test (npm run dev) only: true = real addresses also get a real email
# from Gmail (fake ones like @shop.test stay in the local inbox)
VITE_LOCAL_REAL_EMAIL=false
