# Cloudinary
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_API_URL=
# Cloudinary for feedback screenshots and files (a separate account, unsigned preset)
VITE_CLOUDINARY_ISSUES_CLOUD_NAME=
VITE_CLOUDINARY_ISSUES_UPLOAD_PRESET=

# Firebase
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
# Server only: Vercel → Settings → Environment Variables (and .env on
# this computer). Never put VITE_ in front of these: they must not reach the browser.
# The Gmail account JPOS sends email from, and its 16-letter app password
GMAIL_USER=
GMAIL_APP_PASSWORD=
# Who gets "new payment" emails (comma-separated). Empty = GMAIL_USER
NOTIFY_EMAIL=
# The app's address for links in emails, e.g. https://jpos.example.com
APP_URL=
# Firebase service account key (the whole JSON, or base64 of it)
FIREBASE_SERVICE_ACCOUNT=
# The feedback Cloudinary account's API key and secret (not used by the app yet)
CLOUDINARY_ISSUES_API_KEY=
CLOUDINARY_ISSUES_API_SECRET=
# Redis Cloud (free plan) cache in front of Firebase, server only:
# redis://default:<database password>@<public endpoint host:port>
# Empty = no cache (everything still works, straight from Firebase)
REDIS_URL=
# Local test (npm run dev) only: true = real addresses also get a real email
# from Gmail (fake ones like @shop.test stay in the local inbox)
VITE_LOCAL_REAL_EMAIL=false
