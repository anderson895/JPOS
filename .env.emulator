# Local test mode (npm run dev:local): fake project, Firebase emulators only.
VITE_USE_EMULATORS=true
VITE_FIREBASE_PROJECT_ID=demo-jpos
VITE_FIREBASE_API_KEY=demo-key
VITE_FIREBASE_AUTH_DOMAIN=demo-jpos.firebaseapp.com
VITE_FIREBASE_APP_ID=demo-app
# Blank out everything else so the real settings in .env are never used here
VITE_FIREBASE_STORAGE_BUCKET=demo-jpos.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_MEASUREMENT_ID=
VITE_CLOUDINARY_CLOUD_NAME=
VITE_CLOUDINARY_UPLOAD_PRESET=
VITE_CLOUDINARY_API_URL=
